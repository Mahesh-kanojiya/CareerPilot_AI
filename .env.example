# CareerPilot AI Configuration

# Environment Mode
ENVIRONMENT=development
PROJECT_NAME="CareerPilot AI"
API_V1_STR=/api/v1
SECRET_KEY=careerpilot_super_secret_jwt_key_change_in_production_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector)
# For Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpilot
# Fallback local sqlite for test/quick local without docker:
# DATABASE_URL=sqlite:///./careerpilot.db

# Vector Dimension (384 for sentence-transformers / compact embeddings, 768 for Gemini)
VECTOR_DIMENSION=384

# Gemini AI API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Job Search APIs (Optional live external endpoints, fallback to integrated high-quality job aggregators)
REMOTEOK_API_URL=https://remoteok.com/api
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
